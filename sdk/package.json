{
  "name": "privacy-cash-sdk",
  "version": "0.1.1",
  "description": "Browser-native client SDK for the Privacy Cash Solana protocol (deposit/withdraw SOL & SPL tokens, ZK proofs, commitment notes).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "setup": "node scripts/setup.mjs"
  },
  "keywords": [
    "solana",
    "privacy",
    "zk-snark",
    "groth16",
    "privacy-cash",
    "zero-knowledge",
    "relayer",
    "merkle-tree"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lightprotocol/hasher.rs": "^0.2.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "ethers": "^6.17.0",
    "ffjavascript": "^0.3.1",
    "snarkjs": "^0.7.6",
    "tweetnacl": "^1.0.3",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@solana/codecs": "^8.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
