# privacy-cash backend configuration.
# Copy to `.env` (gitignored) and fill in real values.

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/privacy_cash

# --- Solana RPC ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Must match declare_id! and the deployed program address.
PROGRAM_ID=HoumtJnPvyaavAdDgoWN78PWLSZYvezghc5FM9sEKEyV

# --- Yellowstone gRPC indexer ---
YELLOWSTONE_GRPC_URL=https://your-yellowstone-endpoint:443
# Optional x-token for authenticated Yellowstone endpoints.
YELLOWSTONE_X_TOKEN=
INDEXER_RECONNECT_SECS=3

# --- Operator (relayer) keypair + fees ---
# Path to a Solana keypair JSON (byte array). Signs operator/submitted txns.
RELAYER_KEYPAIR=./relayer-keypair.json
RELAYER_FEE_RECIPIENT=
RELAYER_FEE_RATE_BPS=25
# Comma-separated SPL mints to support (USDC, USDT by default).
SUPPORTED_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# --- Operator console password ---
# Guards the mutating operator routes (/api/relayer/initialize, *-spl,
# update-config, update-deposit-limit(-spl)) via the x-admin-password header,
# verified by POST /api/admin/verify. When UNSET, operator routes fail closed.
# Choose a strong value in production.
ADMIN_PASSWORD=changeme

# --- Logging ---
RUST_LOG=info,privacy_cash_backend=debug
