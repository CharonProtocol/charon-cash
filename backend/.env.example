# charon backend configuration.
# Copy to `.env` (gitignored) and fill in real values.

# --- Postgres ---

# --- Yellowstone gRPC indexer ---
# Backend-only. Never expose YELLOWSTONE_* (or RELAYER_KEYPAIR) via VITE_* /
# frontend env — the browser only uses VITE_BACKEND_URL.
YELLOWSTONE_GRPC_URL=http://127.0.0.1:10000
# Optional x-token for authenticated Yellowstone endpoints.
YELLOWSTONE_X_TOKEN=
INDEXER_RECONNECT_SECS=3
# Local Surfpool only: poll RPC when Yellowstone does not emit transactions.
INDEXER_RPC_FALLBACK=false


# Comma-separated SPL mints to support (USDC, USDT by default).
SUPPORTED_MINTS=11111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# --- Operator console password ---
# Guards the mutating operator routes (/api/relayer/initialize, *-spl,
# update-config, update-deposit-limit(-spl)) via the x-admin-password header,
# verified by POST /api/admin/verify. When UNSET, operator routes fail closed.
# Choose a strong value in production.
ADMIN_PASSWORD=changeme

# --- Logging ---
RUST_LOG=info,charon_backend=debug

PROGRAM_ID=8MDh3D29Rx4MQjdan1UG1K3dZs9jxTF4922QkEP1zhtW
RELAYER_KEYPAIR=/home/gou/Solana/charon/target/deploy/relayer.json
DATABASE_URL=postgres://postgres:postgres@localhost:5433/charon
RELAYER_FEE_RECIPIENT=8kFC2MKp5Sn7EsKTw6Pu2jEAfMtH4snAJJJdLZ3refg3
RELAYER_FEE_RECIPIENT_KEYPAIR=/home/gou/Solana/charon/target/deploy/fee-recipient.json
RELAYER_ALT_ADDRESS=6Lg33YrDSTTdjQgMThQ7nXaP3NvhYviYXWre3cJBJXUm
