# Local backend for the existing devnet deployment. No deployment is performed.
# Copy to backend/.env.devnet (ignored), fill in the placeholders, then follow DEVNET.md.
PROGRAM_ID=7CsXQpehxTrhuX53zNgFLNdRiRLKfkkUcCX6Uy8DxzJ5
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=postgres://charon:charon-local-only@127.0.0.1:5434/charon_devnet
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
INDEXER_RECONNECT_SECS=3
# true selects ordered RPC polling; false selects Yellowstone after RPC backfill.
INDEXER_RPC_FALLBACK=true
# The SOL sentinel plus this deployment's 6-decimal test token.
SUPPORTED_MINTS=11111111111111111111111111111112,3ZFLKuGzHRKtd5WyfBkrP3jtcK4jTGYoHQ4KVUtfLZKT

# A separate, funded devnet hot wallet is required. Never use the fee recipient
# or deployment authority as the relayer signer; startup rejects that combination.
# The local runner creates target/deploy/devnet-relayer.json by default.
# RELAYER_KEYPAIR=/absolute/path/to/devnet-relayer.json
RELAYER_FEE_RECIPIENT=GAn8V81NM8Qkmyds8RNDM6GVwruEW31dDoVDpC9CWJz1
RELAYER_ALT_ADDRESS=7aPvfLCDc1XL4CzEstrDazYDupmmMPyLA2ttbnfFY27r
RELAYER_SKIP_PREFLIGHT=false
# Leave ADMIN_PASSWORD unset to disable operator mutations during browser testing.
RUST_LOG=info,privacy_cash_backend=debug
