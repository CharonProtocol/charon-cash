VITE_BACKEND_URL=http://localhost:8080
# Public Solana RPC for wallet adapter reads (balances, blockhash). Do NOT put
# Yellowstone / indexer secrets here — those stay in backend/.env only.
VITE_SOLANA_RPC_URL=http://localhost:8899

# Optional: override the on-chain program id. If unset, the client fetches it
# from the backend's GET /api/relayer/info at runtime.
# VITE_PROGRAM_ID=J5coK8Z...

# Address Lookup Table — required for SPL deposits (tx too large without it).
# ./run.sh creates one automatically; or: PROGRAM_ID=... bun frontend/scripts/create-alt.mjs
# VITE_ALT_ADDRESS=...
