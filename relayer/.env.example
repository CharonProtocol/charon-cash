# Privacy Cash relayer.
#
# This process signs user withdrawals, transfers and swaps. It is deliberately a
# separate service from the indexer backend: the key below is hot, and the backend
# holds the database and serves public reads. Keeping them apart means a compromise
# of the read path cannot reach the key.
#
# The relayer is a broadcaster and a rent payer, never an authority. Recipient,
# amount, fee, fee recipient, mint and both ciphertexts are all bound into
# `ext_data_hash`, a Groth16 public input the program verifies, so the relayer cannot
# steal, redirect, skim or forge. It can only refuse, delay, reorder and observe.

RELAYER_BIND_ADDR=0.0.0.0:8081
SOLANA_RPC_URL=http://127.0.0.1:8899
PROGRAM_ID=HoumtJnPvyaavAdDgoWN78PWLSZYvezghc5FM9sEKEyV

# --- Keys ---

# Hot signing key: pays the transaction fee AND two nullifier accounts' rent
# (~1,795,680 lamports) on every transact. It is reimbursed the fee in the same
# transaction, so treat this balance as working capital rather than gas.
RELAYER_KEYPAIR=/path/to/relayer-signer.json

# Where protocol fees accrue. MUST differ from the signing key, and should be cold.
# The relayer refuses to relay unless the proof commits the fee to this address.
RELAYER_FEE_RECIPIENT=

# Optional. Set this only if you want the relayer to top the signer up automatically
# from fee revenue. Leaving it unset keeps the fee account cold; the relayer then
# alarms on a low float and an operator sweeps by hand.
# RELAYER_FEE_RECIPIENT_KEYPAIR=/path/to/fee-recipient.json

# --- Economics ---

# Added on top of rent + transaction fee when deciding whether a request pays its
# own way. Nullifier rent is ~250x the transaction fee and is never recoverable, so
# this floor — not the transaction fee — is what keeps the service solvent.
RELAYER_FEE_MARGIN_LAMPORTS=50000

# Alarm threshold for the signer's float, and the balance a sweep tops it up to.
RELAYER_MIN_SIGNER_BALANCE_LAMPORTS=100000000
RELAYER_SIGNER_TOPUP_LAMPORTS=500000000

# --- SPL ---

# SPL transacts need an Address Lookup Table: a 352-byte proof plus two ciphertexts
# plus 16 accounts does not fit in a 1232-byte packet. Without this, the relayer
# serves native SOL only and returns NOT_CONFIGURED for SPL.
# RELAYER_ALT_ADDRESS=

SUPPORTED_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# --- Abuse defenses ---

RELAYER_RATE_LIMIT_PER_IP_PER_MIN=30
RELAYER_RATE_LIMIT_GLOBAL_PER_MIN=600
RELAYER_MAX_BODY_BYTES=262144

# Leave false in production. Simulation is the last gate before the relayer spends
# anything, and a failed simulation is free while a failed transaction is not.
RELAYER_SKIP_PREFLIGHT=false

RUST_LOG=info,privacy_cash_relayer=debug
