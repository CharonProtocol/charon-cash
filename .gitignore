*/dist
Cargo.lock
# CI builds the deployed program and prover against reviewed dependency versions.
!/Cargo.lock
.DS_Store

# Backend
backend/.env

# Frontend
app/node_modules
app/.next
app/.env
app/.env.local
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.local
frontend/coverage
frontend/.vite
frontend/.oxlint
frontend/target

# Client SDK large native artifacts (regenerated by `frontend/scripts/setup-native-deps.mjs`)
frontend/public/circuit/

# Cloned upstream SDK — separate git repo, must NOT be nested into this one.
# Clone it as a sibling:  git clone https://github.com/Privacy-Cash/privacy-cash-sdk


# IDE
.vscode
.idea

.codegraph/

# QEDGen — tool install, build output, and scratch run state.
# The qedgen skill and its 26 MB binary belong in ~/.agents/skills/qedgen,
# not in the project; see the QEDGen verification section of README.md.
/.agents/
/verification/programs/target/
**/.qed/*.log
**/.qed/last-error.*
**/.qed/verify-evidence.json
/verification/fuzz/*/target/

# ...but the generated crate's lockfile must be committed: codegen's built-in
# compile check runs cargo with --locked and fails without it.
!/verification/programs/Cargo.lock

# Program crates: circomlib install for circuit compilation, stray per-crate builds.
node_modules/
/programs/*/target/

/.claude/
/CLAUDE.md

# surfpool
.surfpool/
runbooks

txtx.yml
docs/

**/target
**/silent_pay_merkle_store.db/
